{
  "expo": {
    "name": "Nexi",
    "slug": "nexi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nexus.nexi",
      "supportsTablet": false
    },
    "plugins": [
      "expo-build-properties",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ]
  }
}